<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:edit="clr-namespace:AvaloniaEdit;assembly=AvaloniaEdit" xmlns:svg="clr-namespace:Avalonia.Svg;assembly=Avalonia.Svg" x:Class="MarkdownDesk.MainWindow" Title="markdim" Width="1360" Height="860" MinWidth="900" MinHeight="600" WindowState="Maximized" KeyDown="WindowKeyDown">
  <Grid RowDefinitions="30,*,28" ColumnDefinitions="*">
    <Menu Grid.Row="0" Background="{DynamicResource AppSurfaceBrush}" AutomationProperties.Name="Application menu">
      <MenuItem Name="FileMenuItem" Header="_Fichier">
        <MenuItem Header="_Nouveau     Ctrl+N" Click="NewDocumentClick"/>
        <Separator/>
        <MenuItem Header="_Ouvrir un fichier…     Ctrl+O" Click="OpenFileClick"/>
        <MenuItem Header="Ouvrir un _dossier…     Ctrl+Shift+O" Click="OpenFolderClick"/>
        <MenuItem Name="OpenRecentMenuItem" Header="Ouvrir _récent"/>
        <Separator/>
        <MenuItem Header="_Fermer l’onglet     Ctrl+W" Click="CloseActiveDocumentClick"/>
        <MenuItem Header="_Enregistrer     Ctrl+S" Click="SaveClick"/>
        <MenuItem Header="Enregistrer _sous…     Ctrl+Shift+S" Click="SaveAsClick"/>
        <MenuItem Header="Exporter en _PDF…     Ctrl+Shift+E" Click="ExportPdfClick"/>
        <Separator/>
        <MenuItem Header="Paramètres de l’_interface…" Click="SettingsClick"/>
        <Separator/>
        <MenuItem Header="_Quitter" Click="QuitClick"/>
      </MenuItem>
      <MenuItem Header="É_dition">
        <MenuItem Header="_Rechercher dans le document     Ctrl+F" Click="FindInDocumentClick"/>
        <MenuItem Header="Rechercher et _remplacer     Ctrl+H" Click="ReplaceInDocumentClick"/>
        <Separator/>
        <MenuItem Header="Aller à la _recherche     Ctrl+K" Click="FocusSearchClick"/>
        <MenuItem Header="Aller à l’é_diteur     Ctrl+E" Click="FocusEditorClick"/>
        <MenuItem Header="Tout _sélectionner     Ctrl+A" Click="SelectAllClick"/>
      </MenuItem>
      <MenuItem Header="_Document">
        <MenuItem Header="Document _précédent     Ctrl+Shift+Tab" Click="PreviousDocumentClick"/>
        <MenuItem Header="Document _suivant     Ctrl+Tab" Click="NextDocumentClick"/>
        <Separator/>
        <MenuItem Header="Déplacer l’onglet à _gauche     Ctrl+Shift+Page Up" Click="MoveTabLeftClick"/>
        <MenuItem Header="Déplacer l’onglet à _droite     Ctrl+Shift+Page Down" Click="MoveTabRightClick"/>
      </MenuItem>
      <MenuItem Header="_Affichage">
        <MenuItem Header="Afficher/masquer la _bibliothèque" Click="ToggleLibraryClick"/>
        <MenuItem Header="Afficher/masquer l’é_diteur" Click="ToggleEditorClick"/>
        <MenuItem Header="Afficher/masquer l’a_perçu" Click="TogglePreviewClick"/>
        <Separator/>
        <MenuItem Name="FullScreenMenuItem" Header="Plein écran     F11" Click="FullScreenClick"/>
      </MenuItem>
      <MenuItem Header="_Aide">
        <MenuItem Header="Raccourcis _clavier" Click="ShortcutsClick"/>
        <MenuItem Header="À _propos de markdim" Click="AboutClick"/>
      </MenuItem>
    </Menu>
    <Grid Grid.Row="1" Name="WorkspaceGrid" DragDrop.AllowDrop="True">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="44"/>
        <ColumnDefinition Width="264"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource AppWindowBackgroundBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
        <StackPanel Margin="4,10" Spacing="6">
          <Button Name="LibraryVisibilityButton" Click="ToggleLibraryClick" Width="36" Height="38" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Afficher ou masquer la bibliothèque" AutomationProperties.Name="Afficher ou masquer la bibliothèque">
            <svg:Svg Name="LibraryVisibilityIcon" Width="20" Height="20" Stretch="Uniform" Path="/Assets/Icons/folder-light.svg"/>
          </Button>
          <Button Name="EditorVisibilityButton" Click="ToggleEditorClick" Width="36" Height="38" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Afficher ou masquer l’éditeur" AutomationProperties.Name="Afficher ou masquer l’éditeur">
            <svg:Svg Name="EditorVisibilityIcon" Width="20" Height="20" Stretch="Uniform" Path="/Assets/Icons/file-light.svg"/>
          </Button>
          <Button Name="PreviewVisibilityButton" Click="TogglePreviewClick" Width="36" Height="38" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Afficher ou masquer l’aperçu" AutomationProperties.Name="Afficher ou masquer l’aperçu">
            <svg:Svg Name="PreviewVisibilityIcon" Width="20" Height="20" Stretch="Uniform" Path="/Assets/Icons/eye-light.svg"/>
          </Button>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Name="LibraryPane" Background="{DynamicResource AppSidebarBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,1,0">
        <DockPanel Margin="18,20">
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,14">
            <TextBlock Text="Bibliothèque" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource AppTextBrush}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Click="OpenFolderClick" Width="36" Height="36" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" ToolTip.Tip="Ouvrir un dossier" AutomationProperties.Name="Ouvrir un dossier">
              <svg:Svg Name="OpenFolderIcon" Width="17" Height="17" Stretch="Uniform" Path="/Assets/Icons/folder-light.svg"/>
            </Button>
          </Grid>
          <TextBox DockPanel.Dock="Top" Name="SearchBox" Watermark="Rechercher un document…" Margin="0,0,0,16" Padding="10,9" Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="1" CornerRadius="7" TextChanged="SearchChanged"/>
          <TextBlock DockPanel.Dock="Top" Text="DOCUMENTS OUVERTS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedTextBrush}" Margin="2,0,0,9"/>
          <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
            <StackPanel Spacing="8">
              <TextBlock Text="PLAN DU DOCUMENT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedTextBrush}" Margin="2,0,0,0"/>
               <ListBox Name="HeadingOutlineList" Height="170" Foreground="{DynamicResource AppTextBrush}" SelectionChanged="HeadingOutlineSelected" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="4,3"/>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>
           <ListBox Name="FileList" Foreground="{DynamicResource AppTextBrush}" SelectionChanged="FileSelected" Background="Transparent" BorderThickness="0">
             <ListBox.ItemTemplate>
               <DataTemplate>
                 <Border Padding="12,5" HorizontalAlignment="Stretch" Background="Transparent" ToolTip.Tip="{Binding LocationLabel}">
                   <Border.ContextMenu>
                     <ContextMenu>
                       <MenuItem Header="Fermer le document" Tag="{Binding}" Click="CloseDocumentFromLibraryClick"/>
                     </ContextMenu>
                   </Border.ContextMenu>
                   <StackPanel Spacing="3">
                      <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding LocationLabel}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                   </StackPanel>
                 </Border>
               </DataTemplate>
             </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
      <GridSplitter Grid.Column="2" Name="LibrarySplitter" Background="{DynamicResource AppBorderBrush}" ToolTip.Tip="Glisser pour redimensionner la bibliothèque"/>
      <Grid Grid.Column="3" RowDefinitions="48,*">
        <Border Background="{DynamicResource AppSurfaceBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1">
          <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel Name="Tabs" Orientation="Horizontal" Margin="12,0" VerticalAlignment="Center"/></ScrollViewer>
        </Border>
        <Grid Grid.Row="1" Name="EditorPreviewGrid" Background="{DynamicResource AppCanvasBrush}">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
           <Grid Grid.Column="0" Name="EditorPane" RowDefinitions="44,Auto,*">
             <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,Auto" Margin="20,0"><TextBlock Text="ÉDITEUR" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center"/><TextBlock Name="EditorMetaText" Grid.Column="1" Text="Source Markdown" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center"/></Grid></Border>
            <Border Grid.Row="1" Name="EditorSearchPanel" IsVisible="False" Background="{DynamicResource AppSidebarBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,0,0,1" Padding="10">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                  <TextBox Name="FindTextBox" Watermark="Rechercher dans le document…" TextChanged="FindTextChanged" KeyDown="FindTextBoxKeyDown" Margin="0,0,6,0"/>
                  <Button Grid.Column="1" Content="Précédent" Click="FindPreviousClick" ToolTip.Tip="Occurrence précédente" Margin="0,0,6,0"/>
                  <Button Grid.Column="2" Content="Suivant" Click="FindNextClick" ToolTip.Tip="Occurrence suivante" Margin="0,0,6,0"/>
                  <TextBlock Name="FindStatusText" Grid.Column="3" VerticalAlignment="Center" Foreground="{DynamicResource AppMutedTextBrush}" Margin="6,0"/>
                  <Button Grid.Column="4" Content="Fermer" Click="CloseFindPanelClick"/>
                </Grid>
                <Grid Name="ReplacePanel" IsVisible="False" ColumnDefinitions="*,Auto,Auto">
                  <TextBox Name="ReplaceTextBox" Watermark="Remplacer par…" Margin="0,0,6,0"/>
                  <Button Grid.Column="1" Content="Remplacer" Click="ReplaceCurrentClick" Margin="0,0,6,0"/>
                  <Button Grid.Column="2" Content="Tout remplacer" Click="ReplaceAllClick"/>
                </Grid>
              </StackPanel>
            </Border>
            <edit:TextEditor Grid.Row="2" Name="Editor" ShowLineNumbers="True" LineNumbersForeground="{DynamicResource AppMutedTextBrush}" WordWrap="False" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource AppCanvasBrush}" Foreground="{DynamicResource AppTextBrush}" FontFamily="avares://markdim/Assets/Fonts#JetBrains Mono" FontSize="14" TextChanged="EditorChanged"/>
          </Grid>
          <GridSplitter Grid.Column="1" Name="PreviewSplitter" Background="{DynamicResource AppDividerBrush}" ToolTip.Tip="Drag to resize the editor and preview"/>
          <Grid Grid.Column="2" Name="PreviewPane" RowDefinitions="44,*" Background="{DynamicResource AppSurfaceBrush}">
            <Border BorderBrush="{DynamicResource AppDividerBrush}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,Auto" Margin="20,0"><TextBlock Text="APERÇU" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center"/><TextBlock Text="Rendu en direct" Grid.Column="1" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center"/></Grid></Border>
            <ScrollViewer Grid.Row="1" Name="PreviewScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
              <ContentControl Name="PreviewContent" Margin="28,20"/>
            </ScrollViewer>
          </Grid>
        </Grid>
      </Grid>
    </Grid>
    <Border Grid.Row="2" Background="{DynamicResource AppSidebarBrush}" BorderBrush="{DynamicResource AppBorderBrush}" BorderThickness="0,1,0,0" Padding="12,0">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
        <TextBlock Name="StatusFilePath" Text="Aucun document ouvert" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Name="StatusText" Grid.Column="1" Text="Prêt" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center" Margin="16,0"/>
        <TextBlock Name="StatusCursor" Grid.Column="2" Text="Ligne 1, colonne 1" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center" Margin="16,0"/>
        <TextBlock Name="StatusDocumentDetails" Grid.Column="3" Text="0 lignes · 0 caractères" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center" Margin="16,0"/>
        <TextBlock Name="StatusEncoding" Grid.Column="4" Text="Markdown" FontSize="12" Foreground="{DynamicResource AppMutedTextBrush}" VerticalAlignment="Center" Margin="16,0,0,0"/>
      </Grid>
    </Border>
  </Grid>
</Window>
