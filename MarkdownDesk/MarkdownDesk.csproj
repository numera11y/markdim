<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifiers>win-x64;osx-x64;osx-arm64;linux-x64;linux-arm64</RuntimeIdentifiers>
    <AssemblyName>markdim</AssemblyName>
    <Product>markdim</Product>
    <ApplicationIcon>Assets\markdim.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <Authors>Numera11y</Authors>
    <Description>A free, open-source desktop Markdown workspace with live preview, multi-document tabs, and local PDF export.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Svg" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="HtmlAgilityPack" />
    <PackageReference Include="PDFsharp-MigraDoc" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="markdim.Localization.%(Filename)%(Extension)" />
    <AvaloniaResource Include="Assets\markdim.ico" />
    <AvaloniaResource Include="Assets\Icons\*.svg" />
    <AvaloniaResource Include="Assets\Fonts\JetBrainsMono-Regular.ttf" />
    <AvaloniaResource Include="Assets\Fonts\JetBrainsMono-Bold.ttf" />
    <AvaloniaResource Include="Assets\Fonts\JetBrainsMono-Italic.ttf" />
    <AvaloniaResource Include="Assets\Fonts\JetBrainsMono-BoldItalic.ttf" />
    <EmbeddedResource Include="Assets\Fonts\IBMPlexSans.ttf" LogicalName="markdim.PdfFonts.IBMPlexSans.ttf" />
    <EmbeddedResource Include="Assets\Fonts\IBMPlexSans-SemiBold.ttf" LogicalName="markdim.PdfFonts.IBMPlexSans-SemiBold.ttf" />
    <EmbeddedResource Include="Assets\Fonts\IBMPlexSans-Italic.ttf" LogicalName="markdim.PdfFonts.IBMPlexSans-Italic.ttf" />
    <EmbeddedResource Include="Assets\Fonts\IBMPlexSans-SemiBoldItalic.ttf" LogicalName="markdim.PdfFonts.IBMPlexSans-SemiBoldItalic.ttf" />
    <EmbeddedResource Include="Assets\Fonts\JetBrainsMono-Regular.ttf" LogicalName="markdim.PdfFonts.JetBrainsMono-Regular.ttf" />
    <EmbeddedResource Include="Assets\Fonts\JetBrainsMono-Bold.ttf" LogicalName="markdim.PdfFonts.JetBrainsMono-Bold.ttf" />
    <EmbeddedResource Include="Assets\Fonts\JetBrainsMono-Italic.ttf" LogicalName="markdim.PdfFonts.JetBrainsMono-Italic.ttf" />
    <EmbeddedResource Include="Assets\Fonts\JetBrainsMono-BoldItalic.ttf" LogicalName="markdim.PdfFonts.JetBrainsMono-BoldItalic.ttf" />
    <None Include="Assets\markdim.svg" />
    <None Update="Assets\Fonts\IBMPlexSans-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets\Fonts\JetBrainsMono-OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="MarkdownDesk.Tests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Highlighting\Markdown.Light.xshd" LogicalName="MarkdownDesk.Highlighting.Markdown.Light.xshd" />
    <EmbeddedResource Include="Highlighting\Markdown.Dark.xshd" LogicalName="MarkdownDesk.Highlighting.Markdown.Dark.xshd" />
    <EmbeddedResource Include="Highlighting\Markdown.Source.Light.xshd" LogicalName="MarkdownDesk.Highlighting.Markdown.Source.Light.xshd" />
    <EmbeddedResource Include="Highlighting\Markdown.Source.Dark.xshd" LogicalName="MarkdownDesk.Highlighting.Markdown.Source.Dark.xshd" />
    <EmbeddedResource Include="Highlighting\Code.Light.xshd" LogicalName="MarkdownDesk.Highlighting.Code.Light.xshd" />
    <EmbeddedResource Include="Highlighting\Code.Dark.xshd" LogicalName="MarkdownDesk.Highlighting.Code.Dark.xshd" />
  </ItemGroup>
</Project>
